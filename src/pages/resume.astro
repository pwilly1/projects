---
const base = import.meta.env.BASE_URL;
const destination = `${base}#experience`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Experience | Preston Willis</title>
  </head>
  <body>
    <main>
      <p>Continue to <a href={destination}>Preston Willis’s experience and background</a>.</p>
    </main>
  </body>
</html>
