---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
    {
    id: 'defi',
    title: 'Uniswap Token & Wallet Tracker',
    image: '/assets/images/uniswap.png',
    overview: 'A real-time monitoring and analysis tool for Uniswap, built with Python, Web3.py, and React for the frontend. It detects new liquidity pairs, analyzes token safety, and tracks wallet activity.',
    builtWith: ['Python', 'Web3.py', 'React', 'FastAPI', 'Render', 'MongoDB'],
    features: [
      'Used Render server to deploy my FastAPI backend and React frontend which allowed for end-to-end access to token and wallet tracking dashboards in real time.',
      'Used Web3 event listeners to detect new Uniswap liquidity pair creations instantly.',
      'Automated token analysis for things like honeypot detection, liquidity evaluation, ownership renouncement checks and more.',
      'Built a wallet tracker to log ERC-20 transfers involving watch-listed addresses.',
      'Kept results in a Mongo database where users can also store wallet addresses that they want to track'
    ],
    highlights: 'Real-time blockchain event handling and an integrated GUI dashboard',
    links: [
      { label: 'GitHub Repository', url: 'https://github.com/pwilly1/eth_bot' }
    ]
  },
  {
    id: 'game',
    title: 'C++ 2D Game/Engine',
    image: '/assets/images/game.png',
    overview: 'A custom-built 2D game engine using SDL3, designed to support tile-based worlds, interactive entities, and real-time gameplay mechanics.',
    builtWith: ['C++', 'SDL3', 'SDL3_image', 'SDL3_ttf', 'TinyXML2', 'CMake'],
    features: [
      'Polymorphic entity system with Player/Enemy classes',
      'Dynamic camera movement and zoom scaling',
      'Tile-based world rendering and chunk parsing',
      'Procedural terrain generation with cellular automata',
      'Break/place tile mechanics and inventory',
      'HUD rendering and map background switching'
    ],
    highlights: 'Smooth game loop with delta time, real-time event handling, and collision detection using AABB',
    links: [
      { label: 'GitHub Repository', url: 'https://github.com/pwilly1/cppproject' }
    ]
  },
  {
    id: 'website',
    title: 'RealView - Real Estate Platform',
    image: '/assets/images/website.png',
    overview: 'A dynamic real estate website built with React, Node.js, and MongoDB, featuring full CRUD functionality and responsive design for both desktop and mobile.',
    builtWith: ['React', 'Node.js', 'Express', 'MongoDB', 'Render', 'CSS Grid/Flexbox'],
    features: [
      'Admin dashboard to add, edit, and delete listings',
      'MongoDB backend with secure API routing and user management',
      'Render-hosted Node.js server with RESTful endpoints',
      'Responsive front-end with reusable React components',
      'Clean UI styled using CSS Flexbox, Grid, and media queries'
    ],
    highlights: 'Full-stack CRUD operations, modular React codebase, mobile-first layout',
    links: [
      { label: 'Live Website', url: 'https://pwilly1.github.io/RealView/' },
      { label: 'Client Code', url: 'https://github.com/pwilly1/RealView' },
      { label: 'Server Code', url: 'https://github.com/pwilly1/react-backend' },
      { label: 'Live Server', url: 'https://react-backend-4pwh.onrender.com/' }
    ]
  }
];

// Work currently in progress — editable list
const inProgress = [
    {
    id: 'App-Builder',
    title: 'App Builder Project',
    short: 'The App Builder Project is a creative platform designed to let users build custom applications without needing to write code, combining a drag-and-drop interface with AI-powered assistance.',
    eta: 'Early 2026',
    links: [{ label: 'GitHub', url: 'https://github.com/pwilly1/AppBuilder' }]
  },
  {
    id: 'mp-support',
    title: 'Multiplayer Support (Game Engine)',
    short: 'Investigating deterministic rollback and network sync for the 2D engine to enable multiplayer matches.',
    eta: 'Q4 2025',
    links: [{ label: 'GitHub', url: 'https://github.com/pwilly1/cppproject' }]
  }
];

---

<BaseLayout title="Preston Willis" description="A clean showcase of my portfolio">
  <!-- Compact resume at the top -->
  <section id="resume" class="resume resume-compact animate-in" data-delay="0">
    <div class="resume-card compact">
      <header class="resume-header compact">
        <div>
          <h2>PRESTON WILLIS</h2>
          <p class="muted small">Computer Science - University of South Carolina (2023–2027)</p>
        </div>
        <div class="contact small">
          <p>803-448-3810 • <a href="mailto:prwillis2@gmail.com">prwillis2@gmail.com</a></p>
          <p>Columbia, SC • <a href="https://github.com/pwilly1" target="_blank" rel="noopener">github.com/pwilly1</a></p>
        </div>
      </header>
        <div class="resume-compact-row">
  <p class="muted small">Computer Science major with experience in C++, real-time systems, automation, and full-stack development.</p>
  <button class="resume-toggle" id="resume-toggle" aria-expanded="false" aria-controls="resume-panel" type="button">View Full Resume</button>
      </div>
        <div id="resume-panel" class="resume-panel" hidden>
          <div class="resume-panel-inner">
          <h3>Professional Summary</h3>
          <p>Computer Science major at the University of South Carolina with strong experience in C++. Skilled in working on real-time systems, automation, and data-driven applications. Experienced in developing full stack projects.</p>

          <h4>Technical Skills</h4>
          <p><strong>Technologies:</strong> Git, MongoDB, Render, React, Node.js</p>

          <h4>Work Experience</h4>
          <h5>Stephen Cooley Real Estate - Intern</h5>
          <p><em>May–Aug 2024 & 2025</em></p>
          <ul>
            <li>Managed and organized digital and physical files, ensuring accessibility and accuracy.</li>
            <li>Optimized the company’s website by enhancing SEO and resolving errors.</li>
            <li>Developed multiple Python automation tools; one validated, formatted, and batch-uploaded closing disclosure data into Google Sheets, increasing filing rate by 30%.</li>
          </ul>

          <h4>Projects</h4>
          <h5>Uniswap Token and Wallet Tracker</h5>
          <ul>
            <li>Used Web3 event listeners to detect new Uniswap liquidity pair creations instantly.</li>
            <li>Automated token analysis for honeypot detection, liquidity evaluation, ownership renouncement checks and more.</li>
            <li>Built a wallet tracker to log ERC-20 transfers involving watch-listed addresses.</li>
            <li>Kept results in a Mongo database where users can also store wallet addresses that they want to track</li>
            <li>Used Render server to deploy my FastAPI backend and React frontend which allowed for end-to-end access to token and wallet tracking dashboards in real time.</li>
          </ul>

          <h5>C++ Game Engine / Game</h5>
          <ul>
            <li>Custom rendering engine with camera system, texture management, and delta time for smooth motion.</li>
            <li>Procedural map generation using cellular automata and noise-based algorithms.</li>
            <li>Physics-based movement with gravity, jumping, and collision detection (tile and object-based) </li>
          </ul>

          <h4>Education</h4>
          <p>Bachelor’s Degree, Computer Science - University of South Carolina (2023 – 2027)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hero">
    <div class="hero-content animate-in" data-delay="40">
    </div>
  </section>

  <section id="projects" class="projects projects-list">
    <h3>Projects</h3>
    <div class="projects-list-inner">
      {projects.map((p, i) => (
        <article class="project-item animate-in" data-delay={i * 90}>
          <div class="project-media">
            <img src={p.image} alt={p.title} />
          </div>
          <div class="project-body">
            <div class="project-header-row">
              <h4>{p.title}</h4>
              <button
                class="project-toggle btn"
                aria-expanded="false"
                aria-controls={`project-${p.id}`}
                type="button"
              >Details</button>
            </div>

            <div id={`project-${p.id}`} class="project-content" hidden>
              <p class="muted">{p.overview}</p>
              <section class="project-details">
                <p><strong>Built With:</strong> {p.builtWith.join(', ')}</p>
                <div>
                  <strong>Features:</strong>
                  <ul>
                    {p.features.map((f) => (<li>{f}</li>))}
                  </ul>
                </div>
                <p><strong>Highlights:</strong> {p.highlights}</p>
              </section>
              <p class="project-links">
                {p.links.map((l) => (
                  <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="in-progress" class="in-progress-section animate-in" data-delay="120">
    <h3>In Progress</h3>
    <div class="in-progress-list">
      {inProgress.map((p) => (
        <article class="in-progress-item">
          <div class="in-progress-media">
          </div>
          <div class="in-progress-body">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem">
              <h4 style="margin:0">{p.title}</h4>
              <span class="badge">In Progress</span>
            </div>
            <p class="muted small">{p.short}</p>
            <p class="muted"><strong>ETA:</strong> {p.eta}</p>
              {p.links ? (
                <p class="project-links">
                  {p.links.map((l) => (
                    <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
                  ))}
                </p>
              ) : null}
          </div>
        </article>
      ))}
    </div>
  </section>


</BaseLayout>
