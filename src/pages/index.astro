---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    index: '02',
    title: 'Uniswap Token & Wallet Tracker',
    category: 'Blockchain monitoring application',
    description:
      'Developed a full-stack Python-based tool to monitor and analyze new Uniswap token launches in real time.',
    bullets: [
      'Used Python, FastAPI, and Web3.py to monitor Uniswap liquidity pair creation events and process new token launches in real time.',
      'Built backend logic to analyze token liquidity, ownership status, and ERC-20 transfers for watch-listed wallets.',
      'Deployed the FastAPI backend and React frontend on Render, providing end-to-end access to real-time token and wallet tracking dashboards.',
    ],
    technologies: ['Python', 'FastAPI', 'Web3.py', 'React', 'MongoDB', 'Render'],
    image: `${base}assets/images/uniswap.png`,
    width: 1008,
    height: 802,
    alt: 'Token tracker interface displaying live liquidity and ownership data',
    links: [{ label: 'View repository', url: 'https://github.com/pwilly1/eth_bot' }],
  },
  {
    index: '03',
    title: 'C++ 2D Platformer',
    category: 'Game and custom engine',
    description:
      'Developed a 2D tile-based platformer from scratch using C++, SDL3, and TinyXML2, implementing core game-engine features.',
    bullets: [
      'Built a custom rendering engine with a camera system, texture management, and delta-time handling for smooth motion.',
      'Implemented procedural map generation using cellular automata and noise-based algorithms, with tunable smoothing iterations and density thresholds.',
    ],
    technologies: ['C++', 'SDL3', 'TinyXML2', 'CMake'],
    image: `${base}assets/images/game.png`,
    width: 1515,
    height: 937,
    alt: 'A procedurally generated cave in the custom C++ platformer',
    links: [{ label: 'View repository', url: 'https://github.com/pwilly1/cppproject' }],
  },
  {
    index: '04',
    title: 'RealView',
    category: 'Full-stack real-estate platform',
    description:
      'Developed a dynamic real-estate website with React, Node.js, Express, and MongoDB, featuring full CRUD functionality and responsive layouts for desktop and mobile.',
    bullets: [
      'Built an admin dashboard for adding, editing, and deleting property listings.',
      'Implemented a MongoDB backend with secure API routing and user management.',
      'Deployed a Node.js server on Render with RESTful endpoints for listing data.',
      'Created a responsive frontend with reusable React components.',
      'Built the interface with CSS Grid, Flexbox, and responsive media queries.',
    ],
    technologies: ['React', 'Node.js', 'Express', 'MongoDB', 'Render'],
    image: `${base}assets/images/website.png`,
    width: 1501,
    height: 843,
    alt: 'RealView property listings interface with filters and listing cards',
    links: [
      { label: 'Visit project', url: 'https://pwilly1.github.io/RealView/' },
      { label: 'View repository', url: 'https://github.com/pwilly1/RealView' },
    ],
  },
];
---

<BaseLayout>
  <section id="top" class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero-heading" data-reveal>
      <p class="section-label">Computer Science · Software Development · Systems Engineering</p>
      <h1 id="hero-title"><span>Preston</span><span>Willis<em>.</em></span></h1>
    </div>

    <div class="hero-lower" data-reveal data-delay="1">
      <p class="hero-intro">
        Computer Science student at the University of South Carolina with experience in full-stack development, AI-assisted tooling, simulation, automation, and systems engineering.
      </p>
      <dl class="hero-facts">
        <div><dt>Location</dt><dd>Columbia, SC</dd></div>
        <div><dt>Degree</dt><dd>B.S. Computer Science</dd></div>
        <div><dt>Graduation</dt><dd>December 2027</dd></div>
      </dl>
      <a class="primary-link" href="#work">Projects <span aria-hidden="true">↓</span></a>
    </div>

    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <section id="work" class="work page-shell" aria-labelledby="work-title">
    <header class="section-intro" data-reveal>
      <p class="section-label">Selected work</p>
      <h2 id="work-title">Projects</h2>
      <p>App generation, blockchain monitoring, game-engine development, and full-stack web development.</p>
    </header>

    <article class="project feature-project" data-reveal>
      <div class="project-copy">
        <div class="project-index"><span>01</span><span>AI-assisted no-code app builder</span></div>
        <h3>Apptura</h3>
        <p class="project-summary">
          AI-assisted no-code mobile app builder that generates fully editable mobile applications from natural-language prompts through a visual editor.
        </p>

        <ul class="project-bullets">
          <li>Achieved consistent rendering across React/TypeScript web and Kotlin/Jetpack Compose Android by building a shared schema for reusable blocks, layouts, actions, and data bindings.</li>
          <li>Designed an AI page-generation pipeline using OpenAI structured outputs, a versioned schema, deterministic compilation, automatic layout and collision repair, and compiler-guided retries.</li>
          <li>Developed a Node.js, Express, and MongoDB backend with more than 30 authenticated and public API routes, deployed across Azure App Service, Static Web Apps, and Blob Storage using GitHub Actions CI/CD.</li>
          <li>Validated usability with 10 users who created 18 multi-page applications; 8 of 10 completed the primary workflow without assistance.</li>
        </ul>

        <div class="system-path" aria-label="Apptura generation path">
          <span>Natural-language prompt</span><i aria-hidden="true">→</i><span>Versioned schema</span><i aria-hidden="true">→</i><span>React and Android runtimes</span>
        </div>

        <a class="project-link" href="https://github.com/pwilly1/AppBuilder" target="_blank" rel="noreferrer">
          View repository <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="schema-visual" aria-label="Apptura system architecture diagram">
        <div class="sheet-heading"><span>APPTURA / SYSTEM MAP</span><span>REV. 08</span></div>
        <div class="schema-body">
          <div class="schema-node node-prompt"><small>INPUT</small><strong>Natural language</strong><span>Application requirements</span></div>
          <span class="connector connector-one" aria-hidden="true"></span>
          <div class="schema-node node-plan"><small>CONTRACT</small><strong>Page schema</strong><span>Blocks · actions · bindings</span></div>
          <span class="connector connector-two" aria-hidden="true"></span>
          <div class="schema-split" aria-hidden="true"></div>
          <div class="schema-node node-web"><small>RUNTIME A</small><strong>React</strong><span>Web editor and preview</span></div>
          <div class="schema-node node-native"><small>RUNTIME B</small><strong>Compose</strong><span>Native Android preview</span></div>
        </div>
        <div class="sheet-footer"><span>Deterministic compilation</span><span>Compiler-guided repair</span></div>
      </div>
    </article>

    <div class="project-list">
      {projects.map((project) => (
        <article class="project project-row" data-reveal>
          <a class="project-media" href={project.links[0].url} target="_blank" rel="noreferrer" aria-label={`${project.links[0].label}: ${project.title}`}>
            <img
              src={project.image}
              width={project.width}
              height={project.height}
              loading="lazy"
              decoding="async"
              alt={project.alt}
            />
            <span aria-hidden="true">View ↗</span>
          </a>
          <div class="project-row-copy">
            <div class="project-index"><span>{project.index}</span><span>{project.category}</span></div>
            <h3>{project.title}</h3>
            <p class="project-description">{project.description}</p>
            <ul class="project-bullets">
              {project.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <p class="project-technologies"><strong>Technologies:</strong> {project.technologies.join(', ')}</p>
            <div class="project-links">
              {project.links.map((link) => (
                <a class="project-link" href={link.url} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="experience page-shell" aria-labelledby="experience-title">
    <header class="section-intro narrow" data-reveal>
      
      <h2 id="experience-title">Experience</h2>
    </header>

    <div class="experience-list">
      <article data-reveal>
        <p class="experience-date">May - August 2026</p>
        <div class="experience-title">
          <h3>Lead Systems Engineer</h3>
          <p>NASA L’SPACE Mission Concept Academy</p>
        </div>
        <div class="experience-description">
          <ul>
            <li>Led an eight-person engineering team for lunar rover mission design, coordinating subsystem requirements, interfaces, trade studies, and technical documentation across four subsystem teams.</li>
            <li>Built a Python command-and-data-handling simulator to model science-data generation, working-memory buffering, onboard-storage usage, compression policies, data-bus throughput, and downlink windows.</li>
            <li>Tracked more than 10 subsystem interfaces and mass, power, and data constraints to improve requirement consistency across the rover architecture.</li>
            <li>Authored system requirements, interface documentation, and trade-study analyses for the rover’s flight computer, onboard storage, and communications architecture.</li>
          </ul>
        </div>
      </article>

      <article data-reveal>
        <p class="experience-date">May - August 2024 and 2025</p>
        <div class="experience-title">
          <h3>Intern</h3>
          <p>Stephen Cooley Real Estate</p>
        </div>
        <div class="experience-description">
          <ul>
            <li>Developed Python automation tools, including a workflow that validated, formatted, and batch-uploaded closing-disclosure data into Google Sheets, increasing the filing rate by 30%.</li>
            <li>Optimized the company website by improving SEO and resolving errors, increasing search visibility and improving page indexing.</li>
            <li>Tracked and maintained more than 100 merchandise inventory items by updating supply counts, identifying low-stock items, and supporting reorder planning.</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <section id="about" class="about page-shell" aria-labelledby="about-title">
    <div class="about-copy" data-reveal>
      <p class="section-label">Education</p>
      <h2 id="about-title">Education and skills</h2>
      <p>University of South Carolina</p>
      <p>Bachelor of Science in Computer Science · GPA: 3.7/4.0 · Expected graduation: December 2027</p>
    </div>

    <div class="toolbox" data-reveal data-delay="1">
      <p class="section-label">Technical skills</p>
      <dl>
        <div><dt>Languages</dt><dd>Java, C++, JavaScript, TypeScript, Python</dd></div>
        <div><dt>Technologies</dt><dd>Git, MongoDB, Render, React, Node.js, Linux, Azure, Express</dd></div>
      </dl>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="page-shell" data-reveal>
      <p class="section-label">Contact</p>
      <h2 id="contact-title">Contact</h2>
      <a href="mailto:prwillis2@gmail.com">prwillis2@gmail.com <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
